# PROMETHEUS local secrets — this file is GITIGNORED, never commit it.
# Fill these in once; every script picks them up automatically.
#
# ---- Dhan (primary broker) ----
# Access token: web.dhan.co -> Profile -> DhanHQ Trading APIs -> Generate Token
DHAN_ACCESS_TOKEN=
DHAN_CLIENT_ID=
# Required only before LIVE money (paper mode ignores this):
DHAN_PIN=
DHAN_TOTP_SECRET=
DHAN_ALGO_ID=
#
# ---- Groww (secondary broker, optional) ----
# Groww API: app.groww.in -> Settings -> API settings (API key + TOTP login flow)
GROWW_TOTP_TOKEN=
GROWW_TOTP_SECRET=
GROWW_CLIENT_ID=
#
# ---- Dashboard access code (set this! protects the online tunnel) ----
PROMETHEUS_DASH_CODE=letmein2026
#
# ---- ARGUS webhook auth (optional) ----
ARGUS_WEBHOOK_SECRET=
